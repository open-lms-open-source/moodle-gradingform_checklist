{{!
    @template gradingform_checklist/grades/grader/gradingpanel

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * instanceid: Instance of the module this grading form belongs too
    * criteria: A gradeable item in the Marking Guide
    * id: The ID of the criteria
    * description: Description of the criteria
    * items: The items that a criteria can be graded at
    * criterionid: The ID of the criteria
    * checked: Flag for if this is the currently selected item
    * definition: Definition of the item
    * remark: Text input for the teacher to relay to the student

    Example context (json):
    {
        "instanceid": "42",
        "criteria": [
            {
                "id": 13,
                "description": "Show your motivation to rock climbing",
                "numitems": 10,
                "numitemschecked": 5,
                "items": [
                    {
                        "criterionid": 13,
                        "checked": true,
                        "definition": "Great work!",
                        "remark": "That's great!"
                    }
                ],
            }
        ],
        "numitems": 10,
        "numitemschecked": 5,
    }
}}
<form id="gradingform_checklist-{{uniqid}}">
    <input type="hidden" name="instanceid" value="{{instanceid}}">
    <div id="checklist-advancedgrading-{{uniqid}}" class="gradingform_checklist">
        {{#benchmark}}
            <div class="benchmark-control benchmark-control-single d-flex justify-content-center w-100 py-3 my-2">
                <button type="button"
                        class="benchmark-toggle btn btn-primary"
                        data-benchmark-id="{{id}}"
                        aria-expanded="false"
                        title="{{buttonlabel}}">
                    <i class="{{buttonicon}} mr-2" aria-hidden="true"></i>
                    <span class="benchmark-button-label">{{buttonlabel}}</span>
                </button>
                <div class="benchmark-content hiddenelement" data-benchmark-content="{{id}}" hidden>
                    <h5 class="benchmark-content-title">{{title}}</h5>
                    <div class="benchmark-content-body">{{{content}}}</div>
                </div>
            </div>
        {{/benchmark}}
        {{#options.enablebulkcheck}}
            <div class="bulkcheckcontrols">
                <button type="button" class="btn btn-primary" data-action="tickall">{{#str}} tickall, gradingform_checklist {{/str}}</button>
            </div>
        {{/options.enablebulkcheck}}
        {{#criteria}}
            <div class="mb-3">
                <div class="d-flex align-items-center mb-2">
                    <h5 id="criterion-description-{{id}}" class="px-0 mb-0 description font-weight-bold">{{{description}}}</h5>
                    <button class="criterion-toggle btn btn-icon icon-no-margin text-reset p-0 font-weight-bold mb-0 ml-auto"
                            type="button"
                            data-toggle="collapse"
                            data-target="#criteria-{{id}}"
                            aria-expanded="true"
                            aria-controls="criteria-{{id}}">
                            <span class="collapsed-icon">
                                {{#pix}} t/collapsed, core {{/pix}}
                                <span class="sr-only">{{#str}} expandcriterion, core_grades {{/str}}</span>
                            </span>
                        <span class="expanded-icon">
                                {{#pix}} t/expanded, core {{/pix}}
                            <span class="sr-only">{{#str}} collapsecriterion, core_grades {{/str}}</span>
                            </span>
                    </button>
                </div>
                <div class="collapse show checklist-criterion" id="criteria-{{id}}" aria-labelledby="criterion-description-{{id}}">
                    {{#items}}
                        <div class="form-check">
                            <input class="form-check-input item"
                                   type="checkbox"
                                   name="advancedgrading[groups][{{criterionid}}][items][{{id}}][id]"
                                   id="advancedgrading-groups-{{criterionid}}-items-{{id}}-id-input"
                                   value="{{id}}"
                                   data-score="{{score}}"
                                {{#checked}}
                                   checked
                                {{/checked}}
                            >
                            <label class="w-100" for="advancedgrading-groups-{{criterionid}}-items-{{id}}-id-input">
                                <span>
                                    {{{definition}}}
                                </span>
                                {{#options.showitempoints}}
                                    <span class="pull-right">
                                        {{#str}}scorepostfix, gradingform_checklist, {{score}}{{/str}}
                                    </span>
                                {{/options.showitempoints}}
                            </label>
                        </div>
                        {{#options.showitemfeedback}}
                            <div class="form-group">
                                <label class="text-muted hiddenelement" for="advancedgrading-groups-{{criterionid}}-items-{{id}}-remark-input">{{#str}} additionalfeedback, core_grades {{/str}}</label>
                                <textarea class="form-control"
                                       name="advancedgrading[groups][{{criterionid}}][items][{{id}}][remark]"
                                       id="advancedgrading-groups-{{criterionid}}-items-{{id}}-remark-input"
                                       cols="10"
                                       rows="1"
                                       data-max-rows="5"
                                       data-auto-rows="true"
                                >{{{remark}}}</textarea>
                            </div>
                        {{/options.showitemfeedback}}
                    {{/items}}
                    {{#options.showgroupfeedback}}
                        <label class="text-muted checklistremarkheading" for="advancedgrading-groups-{{id}}-items-0-remark">
                            {{options.groupremarkheading}}
                        </label>
                        <textarea class="form-control"
                                  name="advancedgrading[groups][{{id}}][items][0][remark]"
                                  id="advancedgrading-groups-{{id}}-items-0-remark"
                                  cols="10"
                                  rows="5"
                                  data-max-rows="5"
                                  data-auto-rows="true"
                        >{{{groupfeedback}}}</textarea>
                    {{/options.showgroupfeedback}}
                {{#options.showgrouppoints}}
                    <div id="pointsgroup-{{id}}" class="pointsgroup">
                        <strong>
                            <span>{{#str}} grouppoints, gradingform_checklist {{/str}}: <span class="scoredpoints">{{grouppoints}}</span>/<span class="outofpoints">{{maxgrouppoints}}</span></span>
                        </strong>
                    </div>
                {{/options.showgrouppoints}}
                </div>
            </div>
        {{/criteria}}
        {{#options.enablebulkcheck}}
            <div class="bulkcheckcontrols">
                <button type="button" class="btn btn-primary" data-action="tickall">{{#str}} tickall, gradingform_checklist {{/str}}</button>
            </div>
        {{/options.enablebulkcheck}}
        {{#options.showgrouppoints}}
            <div id="pointstotals">
                <strong>
                    <span>{{#str}} overallpoints, gradingform_checklist {{/str}}: <span class="scoredpoints">{{points}}</span>/<span class="outofpoints">{{maxpoints}}</span></span>
                </strong>
            </div>
        {{/options.showgrouppoints}}
        {{#options.showobservationdate}}
            {{#observation}}
                <div class="observationdate">
                    <div class="observationdate-title">{{#str}} observationdate, gradingform_checklist {{/str}}</div>
                    {{#isgrading}}
                        <label class="hiddenelement" for="advancedgrading-observation-date">{{#str}} observationdate, gradingform_checklist {{/str}}</label>
                        <input type="date"
                               id="advancedgrading-observation-date"
                               name="advancedgrading[observation][date]"
                               value="{{date}}"
                               class="form-control observationdate-date"
                               required>
                        {{#showtime}}
                            <label class="hiddenelement" for="advancedgrading-observation-time">{{#str}} observationtime, gradingform_checklist {{/str}}</label>
                            <input type="time"
                                   id="advancedgrading-observation-time"
                                   name="advancedgrading[observation][time]"
                                   value="{{time}}"
                                   class="form-control observationdate-time"
                                   required>
                        {{/showtime}}
                    {{/isgrading}}
                    {{^isgrading}}
                        <div class="observationdate-value">{{displayvalue}}</div>
                    {{/isgrading}}
                </div>
            {{/observation}}
        {{/options.showobservationdate}}
    </div>
</form>
{{#js}}
    require(['core/auto_rows', 'jquery'], function(AutoRows, $) {
        AutoRows.init(document.getElementById('gradingform_checklist-{{uniqid}}'));

        $('#gradingform_checklist-{{uniqid}} .benchmark-toggle').on('click', function() {
            const benchmarkId = $(this).data('benchmark-id');
            const source = $('#gradingform_checklist-{{uniqid}} [data-benchmark-content="' + benchmarkId + '"]');
            const title = source.find('.benchmark-content-title').text();
            const body = source.find('.benchmark-content-body').html();
            const constrained = window.innerWidth < 1100 || $('[data-region="pdf"], .assignfeedback_editpdf_widget, .drawingregion, [data-region="review-panel"]').length > 0;
            let target = $('.gradingform_checklist-benchmark-' + (constrained ? 'modal' : 'panel'));
            const currentBenchmark = String(benchmarkId);
            if (!target.length) {
                if (constrained) {
                    $('body').append('<div class="gradingform_checklist-benchmark-modal" role="dialog" aria-modal="true"><div class="benchmark-modal-dialog"><button type="button" class="benchmark-modal-close" aria-label="{{#str}} closebenchmark, gradingform_checklist {{/str}}">&times;</button><h5 class="benchmark-display-title"></h5><div class="benchmark-modal-body"></div></div></div>');
                    target = $('.gradingform_checklist-benchmark-modal');
                    target.find('.benchmark-modal-close').on('click', () => {
                        target.addClass('hiddenelement');
                        $('#gradingform_checklist-{{uniqid}} .benchmark-toggle').attr('aria-expanded', 'false');
                        $('body').removeClass('gradingform_checklist-benchmark-panel-open');
                    });
                } else {
                    $('body').append('<aside class="gradingform_checklist-benchmark-panel" role="complementary"><button type="button" class="benchmark-panel-close" aria-label="{{#str}} closebenchmark, gradingform_checklist {{/str}}">&times;</button><h5 class="benchmark-display-title"></h5><div class="benchmark-panel-body"></div></aside>');
                    target = $('.gradingform_checklist-benchmark-panel');
                    target.find('.benchmark-panel-close').on('click', () => {
                        target.removeClass('open');
                        $('#gradingform_checklist-{{uniqid}} .benchmark-toggle').attr('aria-expanded', 'false');
                        $('body').removeClass('gradingform_checklist-benchmark-panel-open');
                    });
                }
            }
            const isOpen = constrained ? !target.hasClass('hiddenelement') : target.hasClass('open');
            if (isOpen && target.attr('data-current-benchmark') === currentBenchmark) {
                target.toggleClass('hiddenelement', constrained);
                target.removeClass('open');
                $('body').removeClass('gradingform_checklist-benchmark-panel-open');
                $('#gradingform_checklist-{{uniqid}} .benchmark-toggle').attr('aria-expanded', 'false');
                return;
            }
            $('#gradingform_checklist-{{uniqid}} .benchmark-toggle').attr('aria-expanded', 'false');
            $(this).attr('aria-expanded', 'true');
            target.attr('data-current-benchmark', currentBenchmark);
            if (constrained) {
                $('body').removeClass('gradingform_checklist-benchmark-panel-open');
                target.find('.benchmark-display-title').text(title);
                target.find('.benchmark-modal-body').html(body);
                target.removeClass('hiddenelement');
            } else {
                target.find('.benchmark-display-title').text(title);
                target.find('.benchmark-panel-body').html(body);
                target.addClass('open');
                $('body').addClass('gradingform_checklist-benchmark-panel-open');
            }
        });

        /**
         * Formats numeric points for display based on decimal precision.
         *
         * - Whole numbers are displayed without decimals.
         * - Numbers with decimal components are rounded to one decimal place.
         *
         * @param {string|number} points - The points value to format (will be parsed as float)
         * @returns {string} Formatted points as a string
         */
        function formatPoints(points) {
            const num = parseFloat(points);
            if (num % 1 === 0) {
                return num.toString();
            } else {
                return num.toFixed(1);
            }
        }

        $('#gradingform_checklist-{{uniqid}} .form-check-input.item').change(function () {
            updatePoints();
            updateBulkCheckButton();
        });

        function updatePoints() {
            $('#gradingform_checklist-{{uniqid}} .checklist-criterion').each(function() {
                const criterion = $(this);
                let grouppointscents = 0;

                criterion.find('.form-check-input.item:checked').each(function() {
                    const score = parseFloat($(this).attr('data-score')) || 0;
                    grouppointscents += Math.round(score * 100);
                });
                const grouppoints = formatPoints(grouppointscents / 100);
                criterion.find('.pointsgroup').find('.scoredpoints').text(grouppoints);
            });

            let totalpointscents = 0;
            $('#gradingform_checklist-{{uniqid}} .form-check-input.item:checked').each(function() {
                const score = parseFloat($(this).attr('data-score')) || 0;
                totalpointscents += Math.round(score * 100);
            });
            const totalpoints = formatPoints(totalpointscents / 100);
            $('#gradingform_checklist-{{uniqid}} #pointstotals').find('.scoredpoints').text(totalpoints);
        }

        $('#gradingform_checklist-{{uniqid}} .bulkcheckcontrols button').click(function() {
            const checked = $(this).data('action') === 'tickall';
            $('#gradingform_checklist-{{uniqid}} .form-check-input.item').prop('checked', checked);
            updatePoints();
            updateBulkCheckButton();
        });

        function updateBulkCheckButton() {
            const button = $('#gradingform_checklist-{{uniqid}} .bulkcheckcontrols button');
            if (!button.length) {
                return;
            }
            const items = $('#gradingform_checklist-{{uniqid}} .form-check-input.item');
            const allchecked = items.length > 0 && items.filter(':checked').length === items.length;
            if (allchecked) {
                button.data('action', 'untickall');
                button.text({{#quote}}{{#str}} untickall, gradingform_checklist {{/str}}{{/quote}});
            } else {
                button.data('action', 'tickall');
                button.text({{#quote}}{{#str}} tickall, gradingform_checklist {{/str}}{{/quote}});
            }
        }
        updateBulkCheckButton();
    });
{{/js}}
